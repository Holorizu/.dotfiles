{
	"$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
	"palette": {
		"os": "#DCDBF8",
		"closer": "p:os",
		"pink": "#F5C2E7ee",
		"lavender": "#B4BEFE",
		"blue":  "#879BFF"
	},
	"blocks": [
		{
			"alignment": "left",
			"segments": [
				{
					"foreground": "p:os",
					"style": "plain",
					"template": "{{.Icon}} ",
					"type": "os"
				},
				{
					"style": "plain",
					"foreground": "p:closer",
					"template": "[ ",
					"type": "text"
				},
				{
					"foreground": "p:blue",
					"style": "plain",
					"template": "{{ .UserName }} ",
					"type": "session"
				},
				{
					"style": "plain",
					"foreground": "p:closer",
					"template": "]",
					"type": "text"
				},
				{
					"style": "plain",
					"foreground": "p:lightblue",
					"template": "@",
					"type": "text"
				},
				{
					"style": "plain",
					"foreground": "p:closer",
					"template": "[ ",
					"type": "text"
				},
				{
					"foreground": "p:pink",
					"options": {
						"folder_icon": "..\ue5fe..",
						"home_icon": "~",
						"style": "full"
					},
					"style": "plain",
					"template": "{{ .Path }} ",
					"type": "path"
				},
				{
					"foreground": "p:lavender",
					"options": {
						"branch_icon": "\ue725 ",
						"cherry_pick_icon": "\ue29b ",
						"commit_icon": "\uf417 ",
						"fetch_status": false,
						"fetch_upstream_icon": false,
						"merge_icon": "\ue727 ",
						"no_commits_icon": "\uf0c3 ",
						"rebase_icon": "\ue728 ",
						"revert_icon": "\uf0e2 ",
						"tag_icon": "\uf412 "
					},
					"template": "{{ .HEAD }} ",
					"style": "plain",
					"type": "git"
				},
				{
					"style": "plain",
					"foreground": "p:closer",
					"template": "]",
					"type": "text"
				}
			],
			"type": "prompt"
		},
		{
			"alignment": "left",
			"newline": true,
			"segments": [

				{
					"style": "plain",
					"foreground": "p:closer",
					"template": "\uf105",
					"type": "text"
				}
			],
			"type": "prompt"
		}

	],
	"final_space": true,
	"version": 4
}
